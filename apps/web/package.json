{
  "name": "@orochi-network/oh-web-frontend",
  "description": "Web application entry: vite build over the @orochi-network/oh-client-web shell library; dist/ served by apps/cli's oh web",
  "version": "0.1.7-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orochi-network/orochi-harness.git",
    "directory": "apps/web"
  },
  "type": "module",
  "exports": {
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/preview.html",
    "!dist/preview"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "watch": "vite build --watch --no-emptyOutDir",
    "build:preview": "pnpm --filter @orochi-network/oh-experimental-webworker-runtime exec tsdown && pnpm --filter @orochi-network/oh-experimental-webworker-packer exec tsdown && vite build && oh-pack-vfs-image --out dist/preview/vfs-image.tar.gz",
    "serve:preview": "http-server dist -a 0.0.0.0 -p 4173 -c-1"
  },
  "license": "MIT",
  "devDependencies": {
    "@orochi-network/cordis-plugin-group": "workspace:~",
    "@orochi-network/oh-client-modules": "workspace:*",
    "@orochi-network/oh-client-store": "workspace:*",
    "@orochi-network/oh-client-test-runtime": "workspace:*",
    "@orochi-network/oh-client-ui-deliverables": "workspace:*",
    "@orochi-network/oh-client-ui-dockkit": "workspace:*",
    "@orochi-network/oh-client-ui-primitives": "workspace:*",
    "@orochi-network/oh-client-ui-slots": "workspace:*",
    "@orochi-network/oh-client-ui-theme": "workspace:*",
    "@orochi-network/oh-client-web": "workspace:*",
    "@orochi-network/oh-cmdline": "workspace:*",
    "@orochi-network/oh-experimental-agent-team": "workspace:*",
    "@orochi-network/oh-experimental-auto-review": "workspace:*",
    "@orochi-network/oh-experimental-speech-to-text": "workspace:*",
    "@orochi-network/oh-experimental-voice-input-bundle": "workspace:*",
    "@orochi-network/oh-experimental-webworker-packer": "workspace:*",
    "@orochi-network/oh-experimental-webworker-runtime": "workspace:*",
    "@orochi-network/oh-launch-environment": "workspace:*",
    "@orochi-network/oh-pwsh-local": "workspace:*",
    "@orochi-network/oh-remote-mock": "workspace:*",
    "@orochi-network/oh-subprocess-local": "workspace:*",
    "@orochi-network/oh-workspace-changes": "workspace:*",
    "@types/node": "^22.20.4",
    "@types/react": "~18.3.31",
    "@types/react-dom": "~18.3.7",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "^4.7.0",
    "fflate": "^0.8.3",
    "http-server": "^14.1.1",
    "playwright": "^1.63.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^6.0.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.11",
    "ws": "8.22.0"
  }
}
