{
  "name": "@orochi-network/oh-credentials-local",
  "description": "File-backed credentials provider ($OH_HOME/.env under the live process environment) for the Orochi Harness",
  "version": "0.1.7-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orochi-network/orochi-harness.git",
    "directory": "packages/credentials/credentials-local"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@orochi-network/cordis": "workspace:~",
    "@orochi-network/oh-atomic-write": "workspace:*",
    "@orochi-network/oh-credentials": "workspace:*",
    "@orochi-network/oh-home-paths": "workspace:*",
    "@orochi-network/oh-launch-environment": "workspace:*"
  },
  "dependencies": {
    "@orochi-network/schemastery": "workspace:~",
    "chokidar": "^4.0.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@orochi-network/cordis": "workspace:~",
    "@orochi-network/oh-atomic-write": "workspace:*",
    "@orochi-network/oh-credentials": "workspace:*",
    "@orochi-network/oh-home-paths": "workspace:*",
    "@orochi-network/oh-launch-environment": "workspace:*"
  }
}
