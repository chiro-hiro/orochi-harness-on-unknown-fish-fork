{
  "name": "@orochi-network/oh-acp",
  "description": "Automation-only Agent Client Protocol server for driving Orochi Harness agents over JSON-RPC stdio",
  "version": "0.1.7-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orochi-network/orochi-harness.git",
    "directory": "packages/acp/acp"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@agentclientprotocol/sdk": "1.5.1",
    "@orochi-network/oh-brand": "workspace:*",
    "@orochi-network/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@orochi-network/cordis": "workspace:~",
    "@orochi-network/oh-agent": "workspace:*",
    "@orochi-network/oh-attachment": "workspace:*",
    "@orochi-network/oh-llm": "workspace:*",
    "@orochi-network/oh-mcp-client": "workspace:*",
    "@orochi-network/oh-session": "workspace:*",
    "@orochi-network/oh-session-persistence": "workspace:*",
    "@orochi-network/oh-token-meter": "workspace:*",
    "@orochi-network/oh-user-approval": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@orochi-network/oh-token-meter": {
      "optional": true
    }
  },
  "devDependencies": {
    "@orochi-network/cordis": "workspace:~",
    "@orochi-network/oh-agent": "workspace:*",
    "@orochi-network/oh-agent-loop": "workspace:*",
    "@orochi-network/oh-agent-loop-testkit": "workspace:*",
    "@orochi-network/oh-attachment": "workspace:*",
    "@orochi-network/oh-llm": "workspace:*",
    "@orochi-network/oh-mcp-client": "workspace:*",
    "@orochi-network/oh-session": "workspace:*",
    "@orochi-network/oh-session-persistence": "workspace:*",
    "@orochi-network/oh-session-persistence-jsonl": "workspace:*",
    "@orochi-network/oh-session-projection": "workspace:*",
    "@orochi-network/oh-token-meter": "workspace:*",
    "@orochi-network/oh-tools": "workspace:*",
    "@orochi-network/oh-user-approval": "workspace:*"
  }
}
