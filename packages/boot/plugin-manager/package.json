{
  "name": "@orochi-network/oh-plugin-manager",
  "description": "Current-profile plugin and bundle management shared by oh CLI, Web and agent tools",
  "version": "0.1.7-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orochi-network/orochi-harness.git",
    "directory": "packages/boot/plugin-manager"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./registry": {
      "types": "./lib/types/registry.d.ts",
      "default": "./lib/types/registry.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./operations": {
      "types": "./lib/types/operations.d.ts",
      "default": "./lib/types/operations.js"
    },
    "./tools": {
      "types": "./lib/types/tools.d.ts",
      "default": "./lib/types/tools.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@orochi-network/oh-app-boot": "workspace:*",
    "@orochi-network/oh-atomic-write": "workspace:*",
    "@orochi-network/oh-util-values": "workspace:*",
    "@orochi-network/schemastery": "workspace:~",
    "execa": "^10.0.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@orochi-network/cordis": "workspace:~",
    "@orochi-network/cordis-plugin-loader": "workspace:~",
    "@orochi-network/oh-brand": "workspace:*",
    "@orochi-network/oh-hmr": "workspace:*",
    "@orochi-network/oh-host-plugin-inventory": "workspace:*",
    "@orochi-network/oh-sandbox": "workspace:*",
    "@orochi-network/oh-sandbox-policy": "workspace:*",
    "@orochi-network/oh-subprocess": "workspace:*",
    "@orochi-network/oh-tools": "workspace:*",
    "@orochi-network/oh-typert-protocol": "workspace:*",
    "@orochi-network/oh-user-approval": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@orochi-network/oh-hmr": {
      "optional": true
    },
    "@orochi-network/oh-user-approval": {
      "optional": true
    }
  },
  "devDependencies": {
    "@orochi-network/cordis": "workspace:~",
    "@orochi-network/cordis-plugin-loader": "workspace:~",
    "@orochi-network/cordis-plugin-timer": "workspace:~",
    "@orochi-network/oh-agent": "workspace:*",
    "@orochi-network/oh-brand": "workspace:*",
    "@orochi-network/oh-hmr": "workspace:*",
    "@orochi-network/oh-host-plugin-inventory": "workspace:*",
    "@orochi-network/oh-package-manifest": "workspace:*",
    "@orochi-network/oh-sandbox": "workspace:*",
    "@orochi-network/oh-sandbox-policy": "workspace:*",
    "@orochi-network/oh-session": "workspace:*",
    "@orochi-network/oh-session-projection": "workspace:*",
    "@orochi-network/oh-subprocess": "workspace:*",
    "@orochi-network/oh-system-prompt": "workspace:*",
    "@orochi-network/oh-tools": "workspace:*",
    "@orochi-network/oh-typert-protocol": "workspace:*",
    "@orochi-network/oh-user-approval": "workspace:*"
  }
}
