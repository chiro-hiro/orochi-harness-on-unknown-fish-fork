{
  "name": "@orochi-network/oh-config-editor",
  "description": "Persist plugin configuration through profile patches and Loader reconciliation",
  "version": "0.1.7-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orochi-network/orochi-harness.git",
    "directory": "packages/boot/config-editor"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@orochi-network/cordis": "workspace:~",
    "@orochi-network/cordis-plugin-include": "workspace:~",
    "@orochi-network/cordis-plugin-loader": "workspace:~",
    "@orochi-network/oh-app-boot": "workspace:*",
    "@orochi-network/oh-hmr": "workspace:*"
  },
  "dependencies": {
    "@orochi-network/oh-atomic-write": "workspace:*",
    "js-yaml": "^4.3.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@orochi-network/cordis": "workspace:~",
    "@orochi-network/cordis-plugin-include": "workspace:~",
    "@orochi-network/cordis-plugin-loader": "workspace:~",
    "@orochi-network/oh-app-boot": "workspace:*",
    "@orochi-network/oh-hmr": "workspace:*",
    "@types/js-yaml": "^4.0.9"
  },
  "peerDependenciesMeta": {
    "@orochi-network/oh-hmr": {
      "optional": true
    }
  }
}
