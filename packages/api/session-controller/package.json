    "@orochi-network/oh-commands": "workspace:*",
    "@orochi-network/oh-credentials": "workspace:*",
    "@orochi-network/oh-file-reference": "workspace:*",
    "@orochi-network/oh-fs": "workspace:*",
    "@orochi-network/oh-llm": "workspace:*",
    "@orochi-network/oh-native-command": "workspace:*",
    "@orochi-network/oh-scope": "workspace:*",
    "@orochi-network/oh-session": "workspace:*",
    "@orochi-network/oh-session-persistence": "workspace:*",
    "@orochi-network/oh-session-projection": "workspace:*",
    "@orochi-network/oh-session-projection-cache": "workspace:*",
    "@orochi-network/oh-session-query": "workspace:*",
    "@orochi-network/oh-session-title": "workspace:*",
    "@orochi-network/oh-settings": "workspace:*",
    "@orochi-network/oh-skill": "workspace:*",
    "@orochi-network/oh-subagent": "workspace:*",
    "@orochi-network/oh-typert-protocol": "workspace:*",
    "@orochi-network/oh-typert-registry": "workspace:*",
    "@orochi-network/oh-util-time": "workspace:*",
    "@orochi-network/oh-util-values": "workspace:*",
    "@orochi-network/oh-util-workspace-path": "workspace:*",
    "@orochi-network/oh-workspace": "workspace:*"
  },
  "peerDependenciesMeta": {
