    "@orochi-network/oh-session-query": "workspace:*",
    "@orochi-network/oh-session-title": "workspace:*",
    "@orochi-network/oh-settings": "workspace:*",
    "@orochi-network/oh-skill": "workspace:*",
    "@orochi-network/oh-storage": "workspace:*",
