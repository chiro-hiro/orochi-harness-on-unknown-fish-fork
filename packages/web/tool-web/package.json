{
  "name": "@orochi-network/oh-tool-web",
  "description": "Model-facing web tools (web_search, web_fetch) over the Orochi Harness web capability seam (ctx.web)",
  "version": "0.1.7-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orochi-network/orochi-harness.git",
    "directory": "packages/web/tool-web"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@orochi-network/cordis": "workspace:~",
    "@orochi-network/oh-llm": "workspace:*",
    "@orochi-network/oh-system-prompt": "workspace:*",
    "@orochi-network/oh-tools": "workspace:*",
    "@orochi-network/oh-web": "workspace:*"
  },
  "dependencies": {
    "@joplin/turndown-plugin-gfm": "^1.0.68",
    "@orochi-network/oh-util-values": "workspace:*",
    "@orochi-network/schemastery": "workspace:~",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@orochi-network/cordis": "workspace:~",
    "@orochi-network/oh-agent": "workspace:*",
    "@orochi-network/oh-llm": "workspace:*",
    "@orochi-network/oh-scope": "workspace:*",
    "@orochi-network/oh-session": "workspace:*",
    "@orochi-network/oh-spill-local": "workspace:*",
    "@orochi-network/oh-spill-policy": "workspace:*",
    "@orochi-network/oh-system-prompt": "workspace:*",
    "@orochi-network/oh-token-meter": "workspace:*",
    "@orochi-network/oh-tool-call-timeout-policy": "workspace:*",
    "@orochi-network/oh-tools": "workspace:*",
    "@orochi-network/oh-web": "workspace:*",
    "@orochi-network/oh-web-fetch-http": "workspace:*",
    "@orochi-network/oh-web-search-exa": "workspace:*",
    "@types/turndown": "^5.0.6"
  }
}
