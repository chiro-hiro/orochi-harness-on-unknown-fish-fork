{
  "name": "@orochi-network/oh-web-fetch-http",
  "description": "Anonymous public HTTP(S) fetch provider for the Orochi Harness web capability seam (ctx.web)",
  "version": "0.1.7-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orochi-network/orochi-harness.git",
    "directory": "packages/web/web-fetch-http"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@orochi-network/cordis": "workspace:~",
    "@orochi-network/oh-http-proxy": "workspace:*",
    "@orochi-network/oh-timeout": "workspace:*",
    "@orochi-network/oh-web": "workspace:*"
  },
  "dependencies": {
    "@orochi-network/schemastery": "workspace:~",
    "ipaddr.js": "^2.5.0",
    "undici": "^8.11.2"
  },
  "devDependencies": {
    "@orochi-network/cordis": "workspace:~",
    "@orochi-network/oh-http-proxy": "workspace:*",
    "@orochi-network/oh-timeout": "workspace:*",
    "@orochi-network/oh-web": "workspace:*"
  }
}
