{
  "name": "@orochi-network/oh-lsp-stdio",
  "description": "Generic stdio language-server provider for the Orochi Harness LSP capability seam (ctx.lsp) — spawns configured servers, translates JSON-RPC, and serves transient-open goToDefinition/findReferences/goToImplementation/hover queries in the host filesystem namespace",
  "version": "0.1.7-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orochi-network/orochi-harness.git",
    "directory": "packages/lsp/lsp-stdio"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@orochi-network/cordis": "workspace:~",
    "@orochi-network/oh-brand": "workspace:*",
    "@orochi-network/oh-fs": "workspace:*",
    "@orochi-network/oh-llm": "workspace:*",
    "@orochi-network/oh-lsp": "workspace:*",
    "@orochi-network/oh-subprocess": "workspace:*",
    "@orochi-network/oh-timeout": "workspace:*"
  },
  "dependencies": {
    "@orochi-network/oh-util-values": "workspace:*",
    "@orochi-network/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@orochi-network/cordis": "workspace:~",
    "@orochi-network/oh-brand": "workspace:*",
    "@orochi-network/oh-fs": "workspace:*",
    "@orochi-network/oh-fs-local": "workspace:*",
    "@orochi-network/oh-llm": "workspace:*",
    "@orochi-network/oh-lsp": "workspace:*",
    "@orochi-network/oh-subprocess": "workspace:*",
    "@orochi-network/oh-subprocess-local": "workspace:*",
    "@orochi-network/oh-timeout": "workspace:*",
    "typescript": "^6.0.3",
    "typescript-language-server": "^5.3.0"
  }
}
