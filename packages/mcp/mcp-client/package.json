{
  "name": "@orochi-network/oh-mcp-client",
  "description": "MCP client bridge: connects to MCP servers and registers their tools on ctx.tools",
  "version": "0.1.7-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orochi-network/orochi-harness.git",
    "directory": "packages/mcp/mcp-client"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@orochi-network/cordis": "workspace:~",
    "@orochi-network/oh-attachment": "workspace:*",
    "@orochi-network/oh-llm": "workspace:*",
    "@orochi-network/oh-mcp-resources": "workspace:*",
    "@orochi-network/oh-scope": "workspace:*",
    "@orochi-network/oh-subprocess": "workspace:*",
    "@orochi-network/oh-system-prompt": "workspace:*",
    "@orochi-network/oh-timeout": "workspace:*",
    "@orochi-network/oh-tools": "workspace:*"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.2.0",
    "@orochi-network/oh-util-values": "workspace:*",
    "@orochi-network/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@modelcontextprotocol/node": "2.1.0",
    "@modelcontextprotocol/server": "2.2.0",
    "@modelcontextprotocol/server-everything": "^2026.8.31",
    "@modelcontextprotocol/server-filesystem": "^2026.8.31",
    "@orochi-network/cordis": "workspace:~",
    "@orochi-network/oh-attachment": "workspace:*",
    "@orochi-network/oh-attachment-local": "workspace:*",
    "@orochi-network/oh-http-proxy": "workspace:*",
    "@orochi-network/oh-llm": "workspace:*",
    "@orochi-network/oh-mcp-resources": "workspace:*",
    "@orochi-network/oh-scope": "workspace:*",
    "@orochi-network/oh-subprocess": "workspace:*",
    "@orochi-network/oh-system-prompt": "workspace:*",
    "@orochi-network/oh-timeout": "workspace:*",
    "@orochi-network/oh-tools": "workspace:*",
    "zod": "^4.6.5"
  },
  "peerDependenciesMeta": {
    "@orochi-network/oh-mcp-resources": {
      "optional": true
    },
    "@orochi-network/oh-system-prompt": {
      "optional": true
    }
  }
}
