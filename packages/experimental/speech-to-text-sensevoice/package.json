{
  "name": "@orochi-network/oh-experimental-speech-to-text-sensevoice",
  "description": "Local SenseVoice ONNX transcription with a managed sherpa-onnx process",
  "version": "0.1.7-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orochi-network/orochi-harness.git",
    "directory": "packages/experimental/speech-to-text-sensevoice"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./worker": {
      "types": "./lib/types/worker.d.ts",
      "default": "./lib/worker.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/worker.js",
    "runtime/assets.json",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@orochi-network/oh-timeout": "workspace:*",
    "@orochi-network/schemastery": "workspace:~",
    "sherpa-onnx-node": "1.13.8",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@orochi-network/cordis": "workspace:~",
    "@orochi-network/oh-experimental-speech-to-text": "workspace:*",
    "@orochi-network/oh-subprocess": "workspace:*"
  },
  "devDependencies": {
    "@orochi-network/cordis": "workspace:~",
    "@orochi-network/oh-experimental-speech-to-text": "workspace:*",
    "@orochi-network/oh-subprocess": "workspace:*",
    "@orochi-network/oh-subprocess-local": "workspace:*",
    "tsx": "^4.23.15"
  }
}
