    "lib/index.js",
    "lib/worker.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@orochi-network/cordis": "workspace:~",
    "@orochi-network/oh-agent": "workspace:*",
    "@orochi-network/oh-browser-use": "workspace:*",
    "@orochi-network/oh-system-prompt": "workspace:*",
    "@orochi-network/oh-tools": "workspace:*"
  },
  "dependencies": {
    "@browserbasehq/stagehand": "4.1.0",
    "@orochi-network/oh-experimental-browser-use-runtime": "workspace:*",
    "@orochi-network/oh-mcp-client": "workspace:*",
    "@orochi-network/oh-subprocess": "workspace:*",
    "@orochi-network/oh-util-values": "workspace:*",
    "@orochi-network/schemastery": "workspace:~",
    "@puppeteer/browsers": "3.2.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@orochi-network/cordis": "workspace:~",
    "@orochi-network/cordis-plugin-include": "workspace:~",
    "@orochi-network/cordis-plugin-loader": "workspace:~",
    "@orochi-network/oh-agent": "workspace:*",
    "@orochi-network/oh-agent-loop": "workspace:*",
    "@orochi-network/oh-agent-loop-testkit": "workspace:*",
    "@orochi-network/oh-attachment": "workspace:*",
    "@orochi-network/oh-attachment-local": "workspace:*",
    "@orochi-network/oh-browser-use": "workspace:*",
    "@orochi-network/oh-llm": "workspace:*",
    "@orochi-network/oh-session": "workspace:*",
    "@orochi-network/oh-session-projection": "workspace:*",
    "@orochi-network/oh-system-prompt": "workspace:*",
    "@orochi-network/oh-tools": "workspace:*",
    "tsx": "^4.23.15"
  }
