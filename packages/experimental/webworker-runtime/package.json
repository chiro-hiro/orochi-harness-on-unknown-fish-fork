{
  "name": "@orochi-network/oh-experimental-webworker-runtime",
  "description": "Browser-only harness runtime: in-memory VFS, module transform and loader, postMessage tunnel, and the dedicated Web Worker assembly, with the Node-compatibility layer that lets the host tree run unchanged",
  "version": "0.1.7-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orochi-network/orochi-harness.git",
    "directory": "packages/experimental/webworker-runtime"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./worker": "./lib/worker.js",
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    }
  },
  "license": "MIT",
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "@orochi-network/oh-client-web": "workspace:*",
    "@orochi-network/oh-util-crypto": "workspace:*",
    "@yarnpkg/parsers": "^3.1.0",
    "acorn": "^8.18.0",
    "buffer": "^6.0.3",
    "picomatch": "^4.0.7",
    "readable-stream": "^4.7.0"
  },
  "peerDependencies": {
    "@orochi-network/cordis": "workspace:~",
    "@orochi-network/cordis-plugin-loader": "workspace:~",
    "@orochi-network/oh-client-connection": "workspace:*",
    "@orochi-network/oh-client-modules": "workspace:*",
    "@orochi-network/oh-host-webserver": "workspace:*"
  },
  "devDependencies": {
    "@orochi-network/cordis": "workspace:~",
    "@orochi-network/cordis-plugin-loader": "workspace:~",
    "@orochi-network/node-addon-system": "workspace:~",
    "@orochi-network/oh-api-gateway": "workspace:*",
    "@orochi-network/oh-app-boot": "workspace:*",
    "@orochi-network/oh-bash-sandbox": "workspace:*",
    "@orochi-network/oh-client-connection": "workspace:*",
    "@orochi-network/oh-client-file-upload": "workspace:*",
    "@orochi-network/oh-client-modules": "workspace:*",
    "@orochi-network/oh-host-webserver": "workspace:*",
    "@orochi-network/oh-sandbox-local": "workspace:*",
    "@orochi-network/oh-sandbox-policy": "workspace:*",
    "@orochi-network/oh-session": "workspace:*",
    "@orochi-network/oh-session-persistence-jsonl": "workspace:*",
    "@orochi-network/oh-session-projection": "workspace:*",
    "@orochi-network/oh-subagent": "workspace:*",
    "@orochi-network/oh-subprocess-local": "workspace:*",
    "@types/picomatch": "^3.0.2",
    "@types/readable-stream": "^4.0.25",
    "chokidar": "^5.0.0"
  },
  "files": [
    "lib/index.js",
    "lib/worker.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
