{
  "name": "@orochi-network/oh-workspace",
  "description": "Workspace entity registry (ctx.workspaceRegistry): durable workspace records with validated session attachment over the domain data form for the Orochi Harness",
  "version": "0.1.7-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orochi-network/orochi-harness.git",
    "directory": "packages/workspace/workspace"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@orochi-network/cordis": "workspace:~",
    "@orochi-network/oh-invariants": "workspace:*",
    "@orochi-network/oh-session": "workspace:*",
    "@orochi-network/oh-session-persistence": "workspace:*",
    "@orochi-network/oh-storage": "workspace:*",
    "@orochi-network/oh-storage-domain": "workspace:*",
    "@orochi-network/oh-typert-protocol": "workspace:*"
  },
  "dependencies": {
    "@orochi-network/oh-brand": "workspace:*",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@orochi-network/cordis": "workspace:~",
    "@orochi-network/oh-invariants": "workspace:*",
    "@orochi-network/oh-session": "workspace:*",
    "@orochi-network/oh-session-persistence": "workspace:*",
    "@orochi-network/oh-storage": "workspace:*",
    "@orochi-network/oh-storage-domain": "workspace:*",
    "@orochi-network/oh-typert-protocol": "workspace:*"
  }
}
