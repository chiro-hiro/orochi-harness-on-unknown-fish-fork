{
  "name": "@orochi-network/oh-time-context",
  "description": "Durable per-step context with the current time and elapsed time",
  "version": "0.1.7-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orochi-network/orochi-harness.git",
    "directory": "packages/context/time-context"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@orochi-network/oh-util-values": "workspace:*",
    "@orochi-network/schemastery": "workspace:~",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@orochi-network/cordis": "workspace:~",
    "@orochi-network/oh-agent": "workspace:*",
    "@orochi-network/oh-invariants": "workspace:*",
    "@orochi-network/oh-llm": "workspace:*",
    "@orochi-network/oh-session": "workspace:*",
    "@orochi-network/oh-session-projection": "workspace:*"
  },
  "devDependencies": {
    "@orochi-network/cordis": "workspace:~",
    "@orochi-network/oh-agent": "workspace:*",
    "@orochi-network/oh-agent-loop": "workspace:*",
    "@orochi-network/oh-agent-loop-testkit": "workspace:*",
    "@orochi-network/oh-app-boot": "workspace:*",
    "@orochi-network/oh-bash-local": "workspace:*",
    "@orochi-network/oh-invariants": "workspace:*",
    "@orochi-network/oh-llm": "workspace:*",
    "@orochi-network/oh-loader-smoke": "workspace:*",
    "@orochi-network/oh-session": "workspace:*",
    "@orochi-network/oh-session-checkpoint-policy": "workspace:*",
    "@orochi-network/oh-session-persistence-jsonl": "workspace:*",
    "@orochi-network/oh-session-projection": "workspace:*",
    "@orochi-network/oh-subprocess-local": "workspace:*",
    "@orochi-network/oh-system-prompt": "workspace:*",
    "@orochi-network/oh-tools": "workspace:*"
  }
}
