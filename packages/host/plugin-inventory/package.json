{
  "name": "@orochi-network/oh-host-plugin-inventory",
  "description": "Read-only Remote projection of current Cordis Loader plugin state",
  "version": "0.1.7-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orochi-network/orochi-harness.git",
    "directory": "packages/host/plugin-inventory"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@orochi-network/cordis": "workspace:~",
    "@orochi-network/cordis-plugin-loader": "workspace:~",
    "@orochi-network/oh-agent-preset-registry": "workspace:*",
    "@orochi-network/oh-brand": "workspace:*",
    "@orochi-network/oh-typert-protocol": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@orochi-network/oh-agent-preset-registry": {
      "optional": true
    }
  },
  "devDependencies": {
    "@orochi-network/cordis": "workspace:~",
    "@orochi-network/cordis-plugin-loader": "workspace:~",
    "@orochi-network/oh-agent-preset-registry": "workspace:*",
    "@orochi-network/oh-app-boot": "workspace:*",
    "@orochi-network/oh-brand": "workspace:*",
    "@orochi-network/oh-package-manifest": "workspace:*",
    "@orochi-network/oh-typert-protocol": "workspace:*"
  }
}
