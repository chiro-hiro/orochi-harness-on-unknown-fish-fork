{
  "name": "@orochi-network/oh-client-ui-plugin-manager",
  "description": "Plugin management for the oh web client: the sidebar Plugins panel installs, enables, disables, retries, and composes installed plugin packages",
  "version": "0.1.7-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orochi-network/orochi-harness.git",
    "directory": "packages/client/ui-plugin-manager"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    }
  },
  "oh": {
    "client": {
      "inject": [
        "@orochi-network/oh-api-remotes",
        "@orochi-network/oh-client-locale",
        "@orochi-network/oh-client-ui-layout",
        "@orochi-network/oh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@orochi-network/cordis": "workspace:~"
  },
  "devDependencies": {
    "@orochi-network/cordis": "workspace:~",
    "@orochi-network/oh-api-remotes": "workspace:*",
    "@orochi-network/oh-client-locale": "workspace:*",
    "@orochi-network/oh-client-store": "workspace:*",
    "@orochi-network/oh-client-test-runtime": "workspace:*",
    "@orochi-network/oh-client-ui-layout": "workspace:*",
    "@orochi-network/oh-client-ui-primitives": "workspace:*",
    "@orochi-network/oh-client-ui-renderer": "workspace:*",
    "@orochi-network/oh-client-ui-settings": "workspace:*",
    "@orochi-network/oh-client-ui-sidebar": "workspace:*",
    "@orochi-network/oh-client-ui-slots": "workspace:*",
    "@orochi-network/oh-package-manifest": "workspace:*",
    "@orochi-network/oh-plugin-manager": "workspace:*",
    "@orochi-network/oh-util-crypto": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "@types/react": "~18.3.31",
    "@types/react-dom": "~18.3.7",
    "clsx": "^2.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "dependencies": {
    "@orochi-network/oh-timeout": "workspace:*",
    "@orochi-network/oh-typert-protocol": "workspace:*",
    "@orochi-network/schemastery": "workspace:~",
    "zod": "^4.6.5"
  }
}
