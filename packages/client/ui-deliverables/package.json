{
  "name": "@orochi-network/oh-client-ui-deliverables",
  "description": "Changed-files card with per-file comparison tabs, delivery cards, and clickable final-response file references for Web",
  "version": "0.1.7-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orochi-network/orochi-harness.git",
    "directory": "packages/client/ui-deliverables"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "oh": {
    "client": {
      "inject": [
        "@orochi-network/oh-api-remotes",
        "@orochi-network/oh-client-connection",
        "@orochi-network/oh-client-locale",
        "@orochi-network/oh-client-ui-chat",
        "@orochi-network/oh-client-ui-conversation",
        "@orochi-network/oh-client-ui-renderer",
        "@orochi-network/oh-client-ui-sidebar-right",
        "@orochi-network/oh-client-ui-tool",
        "@orochi-network/oh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@orochi-network/cordis": "workspace:~"
  },
  "devDependencies": {
    "@orochi-network/cordis": "workspace:~",
    "@orochi-network/oh-agent": "workspace:*",
    "@orochi-network/oh-api-remotes": "workspace:*",
    "@orochi-network/oh-api-session-controller": "workspace:*",
    "@orochi-network/oh-api-workspace-files": "workspace:*",
    "@orochi-network/oh-client-connection": "workspace:*",
    "@orochi-network/oh-client-locale": "workspace:*",
    "@orochi-network/oh-client-store": "workspace:*",
    "@orochi-network/oh-client-test-runtime": "workspace:*",
    "@orochi-network/oh-client-ui-chat": "workspace:*",
    "@orochi-network/oh-client-ui-conversation": "workspace:*",
    "@orochi-network/oh-client-ui-dockkit": "workspace:*",
    "@orochi-network/oh-client-ui-primitives": "workspace:*",
    "@orochi-network/oh-client-ui-renderer": "workspace:*",
    "@orochi-network/oh-client-ui-settings": "workspace:*",
    "@orochi-network/oh-client-ui-sidebar-right": "workspace:*",
    "@orochi-network/oh-client-ui-slots": "workspace:*",
    "@orochi-network/oh-client-ui-tool": "workspace:*",
    "@orochi-network/oh-fs": "workspace:*",
    "@orochi-network/oh-fs-local": "workspace:*",
    "@orochi-network/oh-llm": "workspace:*",
    "@orochi-network/oh-sandbox-policy": "workspace:*",
    "@orochi-network/oh-session": "workspace:*",
    "@orochi-network/oh-session-query": "workspace:*",
    "@orochi-network/oh-system-prompt": "workspace:*",
    "@orochi-network/oh-tool-present": "workspace:*",
    "@orochi-network/oh-util-workspace-path": "workspace:*",
    "@orochi-network/oh-workspace-changes": "workspace:*",
    "@types/react": "~18.3.31",
    "react": "^18.3.1"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ],
  "dependencies": {
    "@orochi-network/oh-typert-protocol": "workspace:*"
  }
}
