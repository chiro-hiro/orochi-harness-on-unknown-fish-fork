{
  "name": "@orochi-network/oh-client-ui-tool",
  "description": "Client Tool call-tree renderer and keyed per-tool presentation slot",
  "version": "0.1.7-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orochi-network/orochi-harness.git",
    "directory": "packages/client/ui-tool"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "oh": {
    "client": {
      "inject": [
        "@orochi-network/oh-api-workspace-controller",
        "@orochi-network/oh-client-connection",
        "@orochi-network/oh-client-locale",
        "@orochi-network/oh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@orochi-network/cordis": "workspace:~"
  },
  "devDependencies": {
    "@orochi-network/cordis": "workspace:~",
    "@orochi-network/oh-agent": "workspace:*",
    "@orochi-network/oh-api-remotes": "workspace:*",
    "@orochi-network/oh-api-workspace-controller": "workspace:*",
    "@orochi-network/oh-attachment": "workspace:*",
    "@orochi-network/oh-client-connection": "workspace:*",
    "@orochi-network/oh-client-locale": "workspace:*",
    "@orochi-network/oh-client-test-runtime": "workspace:*",
    "@orochi-network/oh-client-ui-chat": "workspace:*",
    "@orochi-network/oh-client-ui-conversation": "workspace:*",
    "@orochi-network/oh-client-ui-primitives": "workspace:*",
    "@orochi-network/oh-client-ui-renderer": "workspace:*",
    "@orochi-network/oh-client-ui-session": "workspace:*",
    "@orochi-network/oh-client-ui-slots": "workspace:*",
    "@orochi-network/oh-llm": "workspace:*",
    "@orochi-network/oh-ptc-runtime": "workspace:*",
    "@orochi-network/oh-session": "workspace:*",
    "@orochi-network/oh-spill": "workspace:*",
    "@orochi-network/oh-spill-policy": "workspace:*",
    "@orochi-network/oh-system-prompt": "workspace:*",
    "@orochi-network/oh-token-meter": "workspace:*",
    "@orochi-network/oh-tool-jobs": "workspace:*",
    "@orochi-network/oh-tool-session-query": "workspace:*",
    "@orochi-network/oh-tool-terminal": "workspace:*",
    "@orochi-network/oh-tools": "workspace:*",
    "@orochi-network/oh-util-workspace-path": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "@types/react": "~18.3.31",
    "clsx": "^2.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
