{
  "name": "@orochi-network/oh-client-ui-settings-subagent",
  "description": "Settings page of Subagent delegation on the oh web client's Plugins page: recursion depth, parallel capacity, and the models agents may choose for subagents",
  "version": "0.1.7-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orochi-network/orochi-harness.git",
    "directory": "packages/client/ui-settings-subagent"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "oh": {
    "client": {
      "inject": [
        "@orochi-network/oh-client-locale",
        "@orochi-network/oh-client-ui-settings",
        "@orochi-network/oh-client-ui-plugin-manager",
        "@orochi-network/oh-api-remotes"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@orochi-network/cordis": "workspace:~"
  },
  "devDependencies": {
    "@orochi-network/cordis": "workspace:~",
    "@orochi-network/oh-api-remotes": "workspace:*",
    "@orochi-network/oh-client-locale": "workspace:*",
    "@orochi-network/oh-client-store": "workspace:*",
    "@orochi-network/oh-client-test-runtime": "workspace:*",
    "@orochi-network/oh-client-ui-plugin-manager": "workspace:*",
    "@orochi-network/oh-client-ui-primitives": "workspace:*",
    "@orochi-network/oh-client-ui-renderer": "workspace:*",
    "@orochi-network/oh-client-ui-settings": "workspace:*",
    "@orochi-network/oh-client-ui-slots": "workspace:*",
    "@types/react": "~18.3.31",
    "react": "^18.3.1"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
