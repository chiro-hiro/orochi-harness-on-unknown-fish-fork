{
  "name": "@orochi-network/oh-client-ui-sidebar",
  "description": "Sidebar plugin: session multi-level tree, search, grouping, state dots",
  "version": "0.1.7-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orochi-network/orochi-harness.git",
    "directory": "packages/client/ui-sidebar"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "oh": {
    "client": {
      "inject": [
        "@orochi-network/oh-api-workspace-controller",
        "@orochi-network/oh-client-ui-renderer",
        "@orochi-network/oh-client-ui-layout",
        "@orochi-network/oh-client-ui-session",
        "@orochi-network/oh-client-ui-workspace",
        "@orochi-network/oh-client-locale",
        "@orochi-network/oh-client-shortcuts"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@orochi-network/cordis": "workspace:~"
  },
  "devDependencies": {
    "@orochi-network/cordis": "workspace:~",
    "@orochi-network/oh-api-workspace-controller": "workspace:*",
    "@orochi-network/oh-client-locale": "workspace:*",
    "@orochi-network/oh-client-shortcuts": "workspace:*",
    "@orochi-network/oh-client-store": "workspace:*",
    "@orochi-network/oh-client-test-runtime": "workspace:*",
    "@orochi-network/oh-client-ui-layout": "workspace:*",
    "@orochi-network/oh-client-ui-primitives": "workspace:*",
    "@orochi-network/oh-client-ui-renderer": "workspace:*",
    "@orochi-network/oh-client-ui-session": "workspace:*",
    "@orochi-network/oh-client-ui-slots": "workspace:*",
    "@orochi-network/oh-client-ui-workspace": "workspace:*",
    "@types/react": "~18.3.31",
    "clsx": "^2.1.1",
    "react": "^18.3.1"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
