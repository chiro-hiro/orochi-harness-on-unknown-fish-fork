{
  "name": "@orochi-network/oh-attachment-local",
  "description": "Private content-addressed OH_HOME attachment storage",
  "version": "0.1.7-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orochi-network/orochi-harness.git",
    "directory": "packages/attachment/attachment-local"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@orochi-network/cordis": "workspace:~",
    "@orochi-network/oh-attachment": "workspace:*",
    "@orochi-network/oh-home-paths": "workspace:*"
  },
  "dependencies": {
    "@orochi-network/oh-lazy-require": "workspace:*",
    "@orochi-network/schemastery": "workspace:~",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@orochi-network/cordis": "workspace:~",
    "@orochi-network/oh-attachment": "workspace:*",
    "@orochi-network/oh-home-paths": "workspace:*"
  }
}
